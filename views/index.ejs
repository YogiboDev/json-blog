<%- include('partials/header', { pageTitle: heading, searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : '' }) %>

<h1 class="page-title"><%= heading %></h1>

<% if (posts.length === 0) { %>
  <p class="empty-state"><%= emptyMessage %></p>
<% } else { %>
  <ul class="post-list">
    <% posts.forEach(function(post) { %>
      <li class="post-card">
        <a class="post-card-title" href="/posts/<%= post.id %>"><%= post.title %></a>
        <div class="post-meta">
          <span><%= formatDate(post.date) %></span>
          <span>by <%= post.author %></span>
          <span>💬 <%= commentCounts[post.id] || 0 %></span>
        </div>
        <a class="category-badge" href="/categories/<%= encodeURIComponent(post.category || '未分類') %>"><%= post.category || '未分類' %></a>
        <% if (post.tags && post.tags.length) { %>
          <div class="tag-list">
            <% post.tags.forEach(function(tag) { %>
              <a class="tag" href="/tags/<%= encodeURIComponent(tag) %>"><%= tag %></a>
            <% }) %>
          </div>
        <% } %>
        <p class="post-excerpt"><%= post.content.slice(0, 120) %><%= post.content.length > 120 ? '…' : '' %></p>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>
