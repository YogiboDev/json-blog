<%- include('partials/header', { pageTitle: heading, searchQuery: typeof searchQuery !== 'undefined' ? searchQuery : '' }) %>

<h1 class="page-title"><%= heading %></h1>

<% if (items.length === 0) { %>
  <p class="empty-state"><%= emptyMessage %></p>
<% } else { %>
  <ul class="post-list">
    <% items.forEach(function(item) { %>
      <% var post = item.post; %>
      <li class="post-card">
        <% if (item.isRepost) { %>
          <div class="repost-banner">🔁 <%= formatDate(item.repostDate) %> にリポストされました</div>
        <% } %>
        <a class="post-card-title" href="/posts/<%= post.id %>"><%= post.title %></a>
        <div class="post-meta">
          <span><%= formatDate(post.date) %></span>
          <span>by <%= post.author %></span>
          <span>💬 <%= commentCounts[post.id] || 0 %></span>
          <span>🔁 <%= repostCounts[post.id] || 0 %></span>
        </div>
        <a class="category-badge" href="/categories/<%= encodeURIComponent(post.category || '未分類') %>"><%= post.category || '未分類' %></a>
        <% if (post.tags && post.tags.length) { %>
          <div class="tag-list">
            <% post.tags.forEach(function(tag) { %>
              <a class="tag" href="/tags/<%= encodeURIComponent(tag) %>"><%= tag %></a>
            <% }) %>
          </div>
        <% } %>
        <% var excerptText = stripHtml(post.content); %>
        <p class="post-excerpt"><%= excerptText.slice(0, 120) %><%= excerptText.length > 120 ? '…' : '' %></p>
        <% if (isAuthenticated) { %>
          <form class="repost-form" action="/posts/<%= post.id %>/repost" method="POST">
            <button type="submit" class="btn-repost">🔁 リポスト</button>
          </form>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>
