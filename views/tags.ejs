<%- include('partials/header', { pageTitle: 'タグ' }) %>

<h1 class="page-title">タグ</h1>

<% if (tags.length === 0) { %>
  <p class="empty-state">まだタグがありません。</p>
<% } else { %>
  <ul class="category-list">
    <% tags.forEach(function(t) { %>
      <li class="category-list-item">
        <a href="/tags/<%= encodeURIComponent(t.name) %>"><%= t.name %></a>
        <span class="category-count"><%= t.count %></span>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/footer') %>
